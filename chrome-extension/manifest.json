{
  "manifest_version": 3,
  "name": "FBGroupScraper Pro Helper",
  "version": "1.0.0",
  "description": "Cào bài viết từ Facebook Group bằng phiên trình duyệt đang hoạt động.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "frontend-connector.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FBGroupScraper Helper"
  },
  "oauth2": {
    "client_id": "GOOGLE_EXTENSION_CLIENT_ID",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}