# Environment variables for FBGroupScraper Pro

# Flask/FastAPI Security
SECRET_KEY=super-secret-development-key-change-in-production

# Databases
DATABASE_URL=postgresql://postgres:postgres@db:5432/fbscraper
# For local SQLite setup, use:
# DATABASE_URL=sqlite:///./sqlite.db

# Celery & Caches
REDIS_URL=redis://redis:6379/0

# App Settings
RUNNING_LOCAL_DEV=false
